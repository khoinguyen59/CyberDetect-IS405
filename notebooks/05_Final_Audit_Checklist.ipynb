    "import os, pandas as pd\n",
    "required = [\n",
    " 'data/colab_processed/X_train_top30.parquet',\n",
    " 'data/colab_processed/X_test_top30.parquet',\n",
    " 'models/colab_cyberdetect_mlp.h5',\n",
    " 'models/colab_preprocessing_metadata.json',\n",
    " 'models/colab_preprocessor.joblib',\n",
    " 'results/colab_table3_metrics.csv',\n",
    " 'results/colab_ablation_metrics.csv',\n",
    " 'results/colab_confusion_matrix.csv',\n",
    " 'results/xai/colab_shap_summary.png',\n",
    " 'results/xai/colab_integrated_gradients.png',\n",
    "]\n",
    "with step('Kiem tra artifacts'):\n",
    "    rows=[]\n",
    "    for r in required:\n",
    "        ok=os.path.exists(r)\n",
    "        rows.append({'artifact':r, 'status':'OK' if ok else 'MISSING',\n",
    "                     'size_bytes': os.path.getsize(r) if ok and os.path.isfile(r) else ''})\n",
    "df=pd.DataFrame(rows); print(df.to_string(index=False))\n",
    "df.to_csv('results/final_audit_checklist.csv', index=False)\n",
    "for csv in ['results/colab_table3_metrics.csv','results/colab_ablation_metrics.csv']:\n",
    "    if os.path.exists(csv): print('\\n'+csv); print(pd.read_csv(csv).to_string(index=False))\n",
    "miss=[r['artifact'] for r in rows if r['status']=='MISSING']\n",
    "print('\\n[OK] Day du artifacts.' if not miss else f'\\n[CANH BAO] Thieu: {miss}')"
   ],
